# ─────────────────────────────────────────────────────────────────
# LLM providers — every agent falls back across all four cloud providers in
# an order set per agent-name alias in config/agents_config.yaml's
# model_groups section (see that file's comments). All four keys below are
# required for the default model_groups shipped in that file; only Local
# Ollama needs no key. To run on fewer providers, edit model_groups to use
# only the ones you've configured.
# ─────────────────────────────────────────────────────────────────

# ── Local Ollama (local dev only — never the deployed default) ──────
# Zero-cost, runs entirely on your machine. Install from https://ollama.com
# and run `ollama pull gemma3:12b` (or any model you prefer) first.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b
OLLAMA_TEMPERATURE=0.3
OLLAMA_NUM_CTX=8192

# ── Ollama Cloud ──────────────────────────────────────────────────────
# Same Ollama API, hosted. Sign in with `ollama signin` at https://ollama.com
# to get OLLAMA_API_KEY. Useful when your machine can't run the model locally.
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_API_KEY=

# ── Groq ──────────────────────────────────────────────────────────────
# Fast hosted inference, generous free tier. Get a key at
# https://console.groq.com/keys.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── OpenRouter ────────────────────────────────────────────────────────
# Aggregates many hosted models behind one API. Get a key at
# https://openrouter.ai/keys. Used as a fallback deployment for every agent.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Gemini ────────────────────────────────────────────────────────────
# Google's hosted models. Get a key at https://aistudio.google.com/apikey.
# Used as a fallback deployment for every agent.
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────────
# Search provider selection
# ─────────────────────────────────────────────────────────────────
# auto (serper if SERPER_API_KEY is set, else duckduckgo — no key needed) |
# serper | duckduckgo
SEARCH_PROVIDER=auto
# Serper (opt-in, free tier) — get a key at https://serper.dev
SERPER_API_KEY=

# ─────────────────────────────────────────────────────────────────
# Persistence
# ─────────────────────────────────────────────────────────────────
# SQLite by default for local dev (no setup required). In deployment, point
# this at a managed Postgres instance instead -- we use Neon's free tier
# (https://neon.tech): create a project, enable the "vector" extension in
# its dashboard, and copy the POOLED connection string (not the direct one --
# job_manager runs multiple worker threads, and Neon's free tier has a low
# direct-connection limit). Use the psycopg (v3) driver, not psycopg2:
# postgresql+psycopg://user:pass@host/dbname?sslmode=require
# Migrations are owned by Alembic (`alembic upgrade head`), not create_all --
# see db/session.py::init_db.
DATABASE_URL=sqlite:///research.db
# memory (default, NumPy-backed, no DB dependency) | pgvector (requires
# DATABASE_URL to point at Postgres with the vector extension enabled).
VECTOR_BACKEND=memory
# Gemini embedding model + output dimensionality for the vector backends
# (memory/embedder.py). 768, not the model's native 3072: pgvector cannot
# index vectors above 2000 dimensions.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32
# Cosine similarity threshold (0-1) above which a new question is
# considered a match against a past research_questions entry. Empirical and
# embedding-model-specific -- see the comment beside this setting in
# config/settings.py and eval/calibrate_reuse.py before changing it.
KNOWLEDGE_REUSE_THRESHOLD=0.75

# ─────────────────────────────────────────────────────────────────
# Langfuse tracing (opt-in) — self-hostable, or free tier at
# https://cloud.langfuse.com. Unset: EventBus falls back to a no-op
# trace sink, no network calls attempted, nothing else changes.
# ─────────────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─────────────────────────────────────────────────────────────────
# Frontend (Next.js, frontend/) — comma-separated origins allowed to
# call this API cross-origin.
# ─────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────────────────────────
# Deployment hardening (opt-in) — see README's Deployment section.
# ─────────────────────────────────────────────────────────────────
# Hard kill-switch on total real LLM spend per UTC day, across the whole
# deployment. 0 = uncapped (default).
DAILY_BUDGET_USD=0
# Requests per minute per client IP on /research, /research/async, and
# /research/stream. 0 = disabled (default).
RATE_LIMIT_PER_MINUTE=0
