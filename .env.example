# ─────────────────────────────────────────────────────────────────
# LLM provider selection — pick ONE. Local Ollama is the zero-cost
# default and requires no API key. Cloud providers are strictly opt-in.
# ─────────────────────────────────────────────────────────────────
# ollama_local (default) | ollama_cloud | groq
LLM_PROVIDER=ollama_local
# Model name for the selected provider. Falls back to OLLAMA_MODEL if unset.
LLM_MODEL=gemma3:12b

# ── Local Ollama (default) ─────────────────────────────────────────
# Zero-cost, runs entirely on your machine. Install from https://ollama.com
# and run `ollama pull gemma3:12b` (or any model you prefer) first.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b
OLLAMA_TEMPERATURE=0.3
OLLAMA_NUM_CTX=8192

# ── Ollama Cloud (opt-in) ───────────────────────────────────────────
# Same Ollama API, hosted. Sign in with `ollama signin` at https://ollama.com
# to get OLLAMA_API_KEY. Useful when your machine can't run the model locally.
# Set LLM_PROVIDER=ollama_cloud to use it.
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_API_KEY=

# ── Groq (opt-in) ───────────────────────────────────────────────────
# Fast hosted inference, generous free tier. Get a key at
# https://console.groq.com/keys. Set LLM_PROVIDER=groq and LLM_MODEL to a
# Groq model name, e.g. llama-3.3-70b-versatile.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Per-agent LLM overrides ─────────────────────────────────────────
# Optional. Set llm_provider / llm_model / llm_temperature under any agent
# in config/agents_config.yaml to use a different provider/model for just
# that agent (e.g. a fast Groq model for the Planner/Classifier, a bigger
# model for the Writer). Unset agents fall back to LLM_PROVIDER/LLM_MODEL
# above.

# ─────────────────────────────────────────────────────────────────
# Search provider selection
# ─────────────────────────────────────────────────────────────────
# auto (serper if SERPER_API_KEY is set, else duckduckgo — no key needed) |
# serper | duckduckgo
SEARCH_PROVIDER=auto
# Serper (opt-in, free tier) — get a key at https://serper.dev
SERPER_API_KEY=

# ─────────────────────────────────────────────────────────────────
# Persistence
# ─────────────────────────────────────────────────────────────────
# SQLite by default. Swap for Postgres at scale, e.g.
# postgresql+psycopg2://user:pass@host:5432/research
DATABASE_URL=sqlite:///research.db
# Cosine similarity threshold (0-1) above which a new question is
# considered a match against a past research_questions entry.
KNOWLEDGE_REUSE_THRESHOLD=0.87
